{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MLKer model document v1",
  "type": "object",
  "properties": {
    "format": {
      "const": "mlker.model"
    },
    "schema_version": {
      "const": 1
    },
    "model": {
      "$ref": "#/definitions/model"
    },
    "graphs": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/graph"
      }
    },
    "blocks": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/block"
      }
    },
    "extensions": {
      "type": "object"
    }
  },
  "required": [
    "format",
    "schema_version",
    "model",
    "graphs"
  ],
  "definitions": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
    },
    "tensor": {
      "type": "object",
      "properties": {
        "dtype": {
          "anyOf": [
            {
              "$ref": "#/definitions/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "layout": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "shape": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "$ref": "#/definitions/id"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "extensions": {
          "type": "object"
        }
      }
    },
    "port": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "tensor": {
          "$ref": "#/definitions/tensor"
        },
        "required": {
          "type": "boolean"
        },
        "extensions": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "tensor"
      ]
    },
    "parameter": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "type": {
          "enum": [
            "int",
            "float",
            "bool",
            "string"
          ]
        },
        "default": {
          "type": [
            "integer",
            "number",
            "boolean",
            "string"
          ]
        },
        "extensions": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "type",
        "default"
      ]
    },
    "binding": {
      "anyOf": [
        {
          "type": [
            "integer",
            "number",
            "boolean",
            "string"
          ]
        },
        {
          "type": "object",
          "properties": {
            "$param": {
              "$ref": "#/definitions/id"
            }
          },
          "required": [
            "$param"
          ],
          "additionalProperties": false
        }
      ]
    },
    "endpoint": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "node": {
              "$ref": "#/definitions/id"
            },
            "port": {
              "$ref": "#/definitions/id"
            }
          },
          "required": [
            "node",
            "port"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "input": {
              "$ref": "#/definitions/id"
            }
          },
          "required": [
            "input"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "output": {
              "$ref": "#/definitions/id"
            }
          },
          "required": [
            "output"
          ],
          "additionalProperties": false
        }
      ]
    },
    "edge": {
      "type": "object",
      "properties": {
        "from": {
          "$ref": "#/definitions/endpoint"
        },
        "to": {
          "$ref": "#/definitions/endpoint"
        },
        "extensions": {
          "type": "object"
        }
      },
      "required": [
        "from",
        "to"
      ]
    },
    "implementation": {
      "type": "object",
      "properties": {
        "package": {
          "type": "string",
          "minLength": 1
        },
        "symbol": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "extensions": {
          "type": "object"
        }
      },
      "required": [
        "package",
        "symbol"
      ]
    },
    "node": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "kind": {
          "enum": [
            "operator",
            "module",
            "block",
            "python",
            "opaque"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/port"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/port"
          }
        },
        "params": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/definitions/id"
          },
          "additionalProperties": {
            "$ref": "#/definitions/binding"
          }
        },
        "registry": {
          "$ref": "#/definitions/id"
        },
        "block": {
          "$ref": "#/definitions/id"
        },
        "implementation": {
          "$ref": "#/definitions/implementation"
        },
        "source_op": {
          "type": "string",
          "minLength": 1
        },
        "extensions": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "kind",
        "inputs",
        "outputs"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "operator",
                  "module"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "registry"
            ],
            "properties": {
              "block": false,
              "implementation": false,
              "source_op": false
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "block"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "block"
            ],
            "properties": {
              "registry": false,
              "implementation": false,
              "source_op": false
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "python"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "implementation"
            ],
            "properties": {
              "registry": false,
              "block": false,
              "source_op": false
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "opaque"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "source_op"
            ],
            "properties": {
              "registry": false,
              "block": false,
              "implementation": false
            }
          }
        }
      ]
    },
    "graph": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/port"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/port"
          }
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/parameter"
          }
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/node"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/edge"
          }
        },
        "extensions": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "inputs",
        "outputs",
        "nodes",
        "edges"
      ]
    },
    "block": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "graph": {
          "$ref": "#/definitions/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "extensions": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "graph"
      ]
    },
    "provenance": {
      "type": "object",
      "properties": {
        "source_format": {
          "type": "string",
          "minLength": 1
        },
        "source_identity": {
          "type": "string",
          "minLength": 1
        },
        "strategy": {
          "type": "string",
          "minLength": 1
        },
        "framework_version": {
          "type": "string",
          "minLength": 1
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "extensions": {
          "type": "object"
        }
      },
      "required": [
        "source_format",
        "source_identity",
        "strategy"
      ]
    },
    "model": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "revision": {
          "$ref": "#/definitions/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "metadata": {
          "type": "object"
        },
        "provenance": {
          "$ref": "#/definitions/provenance"
        },
        "entry": {
          "$ref": "#/definitions/id"
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/id"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/id"
          }
        },
        "extensions": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "revision",
        "name",
        "entry",
        "inputs",
        "outputs"
      ]
    }
  }
}
